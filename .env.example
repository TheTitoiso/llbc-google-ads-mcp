# Copie de reference des variables d'environnement a definir sur Railway.
# NE JAMAIS committer un fichier .env rempli : ce depot est PUBLIC.

# --- Acces au serveur MCP ----------------------------------------------------
# Une cle par personne, "secret:nom:role" ; plusieurs cles separees par des
# virgules. Role "full" (lecture + ecriture) ou "read" (lecture seule).
# Secret de 16 caracteres minimum (lettres, chiffres, - _ . ~), a generer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# URL du connecteur claude.ai : https://<domaine>/mcp/<secret>
AUTH_KEYS=

# Nom de la marque (instructions du serveur, /health, journaux)
BRAND_NAME=

# --- Acces API Google Ads ----------------------------------------------------
# Token du Centre API du compte administrateur (MCC)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Client OAuth "Application de bureau" cree dans Google Cloud Console
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Genere avec get_refresh_token.py (ou repris du serveur local, voir README)
GOOGLE_ADS_REFRESH_TOKEN=

# Compte Google Ads servi, 10 chiffres (tirets acceptes). C'est le compte par
# defaut des outils (customer_id facultatif) et tout autre compte est refuse.
# Plusieurs comptes : les separer par des virgules, le premier est le defaut.
# Vide = tout compte accessible, customer_id obligatoire.
GOOGLE_ADS_CUSTOMER_ID=

# ID du compte administrateur (MCC), sans tirets. Necessaire si l'acces au
# compte publicitaire passe par le MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# "true" pour autoriser les modifications (cles "full" seulement).
# "false" = lecture seule pour tout le monde.
GOOGLE_ADS_ALLOW_WRITES=true

# Optionnel : domaines autorises dans l'en-tete Host (separes par des virgules),
# ex. "xxxx.up.railway.app". Vide = protection anti-DNS-rebinding du SDK
# desactivee (l'acces est deja protege par AUTH_KEYS). Si elle est mal reglee,
# le serveur repond 421 "Invalid Host header".
MCP_ALLOWED_HOSTS=
